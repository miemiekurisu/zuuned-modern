build/
# The two Apple-silicon trees are the same kind of local artefact as build/: the
# Debug one carries the gate launches, the Release one the measured sweep.
build-macos/
build-macos-release/
# Local Apple-silicon device runs: isolated profiles, QA fixtures and captured
# session logs. Run artefacts, never source; the directory is recreated per run.
qa-macos/
# Where a built .app/.dmg is staged for hand-testing before it is committed or
# thrown away.  Carrying a 400 MB binary in the index is not repo hygiene.
_tmp/
*.pdb
.codegraph/
.cache/
compile_commands.json
__pycache__/
*.py[cod]

Zuuned-x86_64.AppImage
build-appimage/
packaging/appimage-tools/

# Private authentication material must never enter the public repository.
/libzune/src/mtpz_keys.h
.mtpz-data
*.pem
*.key

# Compiled Qt language catalogues are build output; the .ts and the
# tsv they come from are the source.  See docs/I18N.md.
*.qm
i18n/*.tmp
i18n/build/

# Finder and Explorer metadata records which files a folder held, which is exactly
# the kind of local information this repository keeps out.  One was tracked under
# libzune/ until now.
.DS_Store
Thumbs.db
